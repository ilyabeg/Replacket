<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SettingsComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignDataGridComboBox}">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Thin" />
        <Setter Property="Foreground" Value="{StaticResource InputTxtColorBrush}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="BorderBrush" Value="{StaticResource InputTxtColorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Width" Value="50" />
        <Setter Property="Padding" Value="0,0,0,4" />
        <Setter Property="Margin" Value="5" />
    </Style>
    
</ResourceDictionary>