<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SettingsHeadline" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline4TextBlock}">
        <Setter Property="Text" Value="Settings:" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTxtColorBrush}" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsOptionTxtBlock" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTxtColorBrush}" />
        <Setter Property="Margin" Value="0,5,5,10" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="ProgressHeadline" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline6TextBlock}">
        <Setter Property="Text" Value="Progress..." />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTxtColorBrush}" />
        <Setter Property="Margin" Value="15,5,10,5" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="PacketInfoHeader" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline4TextBlock}">
        <Setter Property="Text" Value="Packet info:" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTxtColorBrush}" />
        <Setter Property="Margin" Value="5,10,10,5" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="PacketInfoTxtBlock" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTxtColorBrush}" />
        <Setter Property="Margin" Value="5,5,0,0" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="PacketBytesTxtBlock" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle2TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTxtColorBrush}" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

</ResourceDictionary>