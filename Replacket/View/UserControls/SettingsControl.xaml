<UserControl x:Class="Replacket.View.UserControls.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Replacket.View.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="400">

    <Grid Background="{StaticResource MaterialDesignLightSeparatorBackground}"
          materialDesign:ThemeAssist.Theme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        
        <!-- Setting headline with gear icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            
            <!-- Gear Icon -->
            <materialDesign:PackIcon Kind="Settings" 
                             Width="32" Height="32" 
                             Foreground="{StaticResource PrimaryTxtColorBrush}" 
                             VerticalAlignment="Center" 
                             Margin="20,40,5,0" />

            <TextBlock 
               Style="{StaticResource SettingsHeadline}" 
               VerticalAlignment="Center" />
            
        </StackPanel>
        
        
        <!-- Options grid -->
        <Grid Grid.Row="1" Margin="10,20,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!-- Delay time -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="DelayTime:" 
                    Style="{StaticResource SettingsOptionTxtBlock}" VerticalAlignment="Center" Margin="0,0,15,20" />

            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Delay, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,15,20">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource InputTxtBox}">
                        <Style.Triggers>

                            <!-- Bind text box to the checkbox IsChecked value (the checkbox is bound to NormalChecked) -->
                            <DataTrigger Binding="{Binding NormalChecked}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding NormalChecked}" Value="False">
                                <Setter Property="IsEnabled" Value="True" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <CheckBox Grid.Row="0" Grid.Column="2" Content="Normal speed" 
                      FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTxtColorBrush}" 
                      VerticalAlignment="Center" Margin="0,0,0,20"
                      IsChecked="{Binding NormalChecked}"/>


            <!-- Repeat -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Repeat:" 
                    Style="{StaticResource SettingsOptionTxtBlock}" VerticalAlignment="Center" Margin="0,0,15,20" />

            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Repeat, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource InputTxtBox}" VerticalAlignment="Center" Margin="0,0,15,20" />


            <!-- Destination interface -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Destination:" 
                    Style="{StaticResource SettingsOptionTxtBlock}" VerticalAlignment="Center" Margin="0,0,15,20" />

            <ComboBox Grid.Row="2" Grid.Column="1" 
                     ItemsSource="{Binding AvailableInterfaces}"
                     SelectedItem="{Binding DestenationInterface}"
                     Style="{StaticResource MaterialDesignDataGridComboBox}" 
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     FontSize="15" FontWeight="Thin"
                     Foreground="{StaticResource InputTxtColorBrush}"
                     FontStyle="Italic" BorderBrush="{StaticResource InputTxtColorBrush}"
                     BorderThickness="0,0,0,1"
                     Width="50" Padding="0,0,0,4"/>


            <!-- Pickup file -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Pickup File:" 
                     Style="{StaticResource SettingsOptionTxtBlock}" VerticalAlignment="Center" Margin="0,0,15,0" />
            
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding PcapFile, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTxtBox}" VerticalAlignment="Center" Margin="0,0,15,0" />

            <Button Grid.Row="3" Grid.Column="2" 
                     Style="{StaticResource FileExplorerBtn}"
                     Command="{Binding BrowsePickupCommand}"/>

        </Grid>
    </Grid>
    
</UserControl>
