<UserControl x:Class="Replacket.View.UserControls.PacketInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Replacket.View.UserControls"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="500" d:DesignWidth="400">
    
    <Grid Background="{StaticResource MaterialDesignLightSeparatorBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        
        <!-- Progress headline with info icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <!-- info icon -->
            <materialDesign:PackIcon Kind="InformationOutline" 
                     Width="32" Height="32" 
                     Foreground="{StaticResource PrimaryTxtColorBrush}" 
                     VerticalAlignment="Center" 
                     Margin="15,10,0,5" />

            <TextBlock Grid.Row="0" Style="{StaticResource PacketInfoHeader}" />

        </StackPanel>


        <Grid Grid.Row="1" Margin="10" >
            <Border BorderThickness="2" BorderBrush="{StaticResource InputTxtColorBrush}"
                    CornerRadius="10">
                <Grid Margin="5">

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <TextBlock Text="{Binding Index}"  Style="{StaticResource PacketInfoTxtBlock}" />
                            <TextBlock Text="{Binding Length}"  Style="{StaticResource PacketInfoTxtBlock}" />
                            <TextBlock Text="{Binding LinkLayer}"  Style="{StaticResource PacketInfoTxtBlock}" />
                            <TextBlock Text="{Binding HexaBytes}"  Style="{StaticResource PacketBytesTxtBlock}" />
                    
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
    
</UserControl>
